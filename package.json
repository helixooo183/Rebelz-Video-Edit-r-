{
  "name": "rebelcut",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "icons": "bash scripts/generate-placeholder-icon.sh",
    "export:web": "expo export --platform web",
    "preview": "npm run export:web && node scripts/serve-web.mjs",
    "serve": "node scripts/serve-web.mjs",
    "docs:previews": "node scripts/generate-screen-previews.mjs && node scripts/generate-screen-overview.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.11",
    "expo-video-thumbnails": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
