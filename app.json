{
  "expo": {
    "name": "Rebel Cut",
    "slug": "rebel-cut",
    "scheme": "rebelcut",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rebelcut.prototype",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.rebelcut.prototype",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0A10",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Rebel Cut"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F9",
          "dark": {
            "backgroundColor": "#0B0A10",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rebel Cut, düzenlemek üzere video seçebilmeniz için galerinize erişir. Videolar cihazınızdan ayrılmaz.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "prototype": true
    }
  }
}
